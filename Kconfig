# =============================================================================
# Conexio Cloud SDK — Kconfig
#
# The only option your application needs to set is:
#   CONFIG_CONEXIO_CLOUD=y
#
# The MQTT broker, Root CA, and all cloud connection details are built into
# the SDK defaults below — no endpoint configuration required in prj.conf.
# =============================================================================

menuconfig CONEXIO_CLOUD
	bool "Conexio Cloud SDK (zero-config)"
	select NRF_MODEM_LIB
	select LTE_LINK_CONTROL
	select NETWORKING
	select NET_SOCKETS
	select NET_SOCKETS_OFFLOAD
	select TLS_CREDENTIALS
	select MODEM_KEY_MGMT
	select CJSON_LIB
	select DATE_TIME
	select MODEM_INFO
	select HTTP_CLIENT
	select HWINFO
	help
	  Enables the Conexio Cloud SDK for nRF91xx devices.
	  Set CONFIG_CONEXIO_CLOUD=y — the broker, Root CA, and cloud
	  connection details are handled by the SDK defaults below.
	  HWINFO is selected automatically to enable reboot reason tracking.

if CONEXIO_CLOUD

# ── Protocol selection ────────────────────────────────────────────────────────

choice CONEXIO_CLOUD_TRANSPORT
	prompt "Transport protocol"
	default CONEXIO_CLOUD_MQTT

config CONEXIO_CLOUD_MQTT
	bool "MQTT over TLS (recommended)"
	select MQTT_LIB
	select MQTT_LIB_TLS
	help
	  Bidirectional — device can receive commands, OTA config pushes,
	  and scheduled actions from the Conexio Console dashboard.

config CONEXIO_CLOUD_HTTP
	bool "HTTPS POST (telemetry + polled commands)"
	help
	  Sends telemetry via POST /v1/ingest. After each successful ingest the
	  SDK automatically polls GET /v1/device-commands and GET /v1/devices/<id>/config/pending
	  so HTTP/sleepy devices can receive commands and OTA config updates.
	  Auth: API key only — no device certificate required.

endchoice

# ── Config fetch endpoint (advanced — not used when STATIC_BROKER_ENABLED=y) ──
# These options describe the Conexio runtime config service path.
# With the default STATIC_BROKER_ENABLED=y they are not used.
# Relevant only when building a self-hosted config service.

config CONEXIO_CLOUD_CONFIG_HOST
	string "Conexio config service hostname"
	default "config.conexio.io"
	help
	  The Conexio runtime configuration service. Returns per-workspace
	  MQTT/HTTP endpoints and credentials based on the device IMEI.
	  Not used when STATIC_BROKER_ENABLED=y (the default).
	  Change only if self-hosting the config service.

config CONEXIO_CLOUD_CONFIG_PATH
	string "Conexio config service path"
	default "/v1/device-config"
	help
	  Path on the config service. The SDK appends ?imei=<IMEI> automatically.
	  Not used when STATIC_BROKER_ENABLED=y (the default).

config CONEXIO_CLOUD_CONFIG_CACHE_SEC
	int "Config cache TTL (seconds)"
	default 3600
	range 300 86400
	help
	  How long to cache the fetched config before re-fetching.
	  Not used when STATIC_BROKER_ENABLED=y (the default).

# ── Static broker override (skip config_fetch) ───────────────────────────────
# Points all devices to the Conexio Cloud MQTT endpoint by default.
# Users do not need to set anything — these defaults are correct for all
# Conexio Cloud SDK deployments.
# Override only if self-hosting the Conexio Cloud backend.

config CONEXIO_CLOUD_STATIC_BROKER_ENABLED
	bool "Use static broker (bypasses config service)"
	default y
	help
	  Connects directly to the Conexio Cloud MQTT broker without going
	  through the config service. Enabled by default — the broker and
	  Root CA URL below are the correct production values for all devices.
	  Disable only if self-hosting the Conexio config service.

config CONEXIO_CLOUD_STATIC_BROKER
	string "Conexio Cloud MQTT broker hostname"
	default "mqtt.cloud.conexiotech.com"
	depends on CONEXIO_CLOUD_STATIC_BROKER_ENABLED
	help
	  Conexio Cloud MQTT endpoint. Do not change unless self-hosting.

config CONEXIO_CLOUD_STATIC_ROOT_CA_URL
	string "Root CA download URL"
	default "https://www.amazontrust.com/repository/AmazonRootCA1.pem"
	depends on CONEXIO_CLOUD_STATIC_BROKER_ENABLED
	help
	  URL to download the Root CA PEM. The default covers the Conexio Cloud
	  endpoint (backed by AWS ACM). Do not change unless self-hosting.

config CONEXIO_CLOUD_STATIC_DEVICE_ID_ENABLED
	bool "Use static device ID (overrides IMEI)"
	default n
	help
	  Enable to use a hardcoded device ID instead of the modem IMEI.
	  Useful for testing with a manually provisioned device identity.

config CONEXIO_CLOUD_STATIC_DEVICE_ID
	string "Static device ID"
	default "stratus-pro-001"
	depends on CONEXIO_CLOUD_STATIC_DEVICE_ID_ENABLED
	help
	  Device ID sent in telemetry and used in MQTT topics.
	  Must match the provisioned device identity exactly.

# ── Telemetry ─────────────────────────────────────────────────────────────────

menu "Telemetry"

config CONEXIO_CLOUD_INTERVAL_SEC
	int "Telemetry publish interval (seconds)"
	default 3600
	range 10 604800
	help
	  How often the SDK publishes a telemetry payload to Conexio Cloud.
	  Minimum: 10 seconds (development / high-frequency monitoring).
	  Maximum: 604800 seconds (7 days — ultra-low-power deployments).
	  For PSM-enabled devices set this to match or exceed PSM_TAU_SEC
	  so the modem wakes only when there is data to send.

config CONEXIO_CLOUD_METRIC_QUEUE_SIZE
	int "Maximum metrics buffered per publish"
	default 16
	range 4 64

config CONEXIO_CLOUD_METRIC_OVERFLOW_LOG
	bool "Log a warning when the metric queue is full"
	default y
	help
	  When enabled (default), the SDK logs a WRN message if
	  conexio_cloud_send_metric() is called while the queue is full.
	  This helps developers catch queue-full conditions during development
	  without having to check return values on every send_metric call.
	  Disable in production to suppress the warning if overflow is expected.

config CONEXIO_CLOUD_MAX_COMMANDS
	int "Maximum number of registered command handlers"
	default 16
	range 4 32
	help
	  Each conexio_cloud_register_command() call uses one slot.

config CONEXIO_CLOUD_MAX_SETTINGS
	int "Maximum number of registered setting handlers"
	default 16
	range 4 32
	help
	  Each conexio_cloud_register_setting_*() call uses one slot.

config CONEXIO_CLOUD_MAX_SENSORS
	int "Maximum number of registered sensor callbacks"
	default 8
	range 2 32
	help
	  Each conexio_cloud_register_sensor() call uses one slot.
	  Sensor callbacks are called automatically before each telemetry publish.

# ── Built-in telemetryIntervalSec setting ─────────────────────────────────────

config CONEXIO_CLOUD_AUTO_INTERVAL_SETTING
	bool "Register telemetryIntervalSec as a built-in OTA Config setting"
	default y
	help
	  When enabled, the SDK automatically handles the 'telemetryIntervalSec'
	  key from OTA Config page pushes — no application handler needed.
	  The value updates the SDK publish interval and is kept in sync with the
	  SET_INTERVAL command. Disable if you want to handle this key yourself.

# ── Auto-metrics ──────────────────────────────────────────────────────────────

config CONEXIO_CLOUD_AUTO_BATTERY
	bool "Auto-include battery voltage (_battery_mv) in every payload"
	default n
	help
	  Reads battery voltage via the modem's AT%%XVBAT command and adds it
	  as the _battery_mv metric in every telemetry payload.
	  For Conexio Stratus Pro with nPM1300, register a sensor callback using
	  conexio_cloud_register_sensor("_battery_mv", read_battery_mv, NULL)
	  to use the more accurate fuel gauge reading instead.

config CONEXIO_CLOUD_BATTERY_METRICS
	bool "Enable nPM1300 fuel gauge battery health metrics"
	default n
	depends on NRF_FUEL_GAUGE
	help
	  When enabled, the SDK reads additional battery health metrics from the
	  nPM1300 fuel gauge on every publish:
	    _battery_soc_pct       — state of charge in percent (0–100)
	    _battery_drain_pct_hr  — average drain rate in %/hour since last publish
	                             (only emitted during discharge; skipped while charging)
	  Requires CONFIG_NRF_FUEL_GAUGE=y and a 'pmic_charger' node in the devicetree.
	  Set CONFIG_CONEXIO_CLOUD_AUTO_BATTERY=n when using this option (avoids
	  double-reporting battery voltage via the less accurate modem AT%%XVBAT path).

config CONEXIO_CLOUD_MODEM_INFO_REFRESH
	int "Modem info refresh interval (publishes)"
	default 5
	range 1 100
	help
	  modem_info_params_get() issues blocking AT commands that take 10–50 ms.
	  This setting controls how often the SDK re-reads RSSI and SNR from the
	  modem — every Nth telemetry publish.  Between refreshes the last cached
	  values are used.  Set to 1 to refresh on every publish (highest accuracy,
	  highest overhead).  Set to 10 to refresh once every 10 publishes.

config CONEXIO_CLOUD_SLOW_METRIC_INTERVAL
	int "Slow metric publish interval (publishes)"
	default 10
	range 2 100
	help
	  How often to include slowly-changing metrics that are unlikely to change
	  between publishes: _lte_band, _cell_id, _tac.
	  A value of 10 means these are included once every 10 publishes.
	  At a 60s telemetry interval this is approximately every 10 minutes.
	  Set to 2 for faster location tracking at the cost of more data.

endmenu # Telemetry

# ── NTP sync timeout ──────────────────────────────────────────────────────────

menu "Connection"

config CONEXIO_CLOUD_NTP_TIMEOUT_SEC
	int "NTP sync timeout (seconds)"
	default 10
	range 3 120
	help
	  Maximum seconds to wait for NTP sync during conexio_cloud_init().
	  The SDK uses an event-driven wait rather than a blind k_sleep().
	  If NTP doesn't respond within this window, init continues and the
	  offline buffer will skip payloads with invalid timestamps.
	  Increase to 60–120s on NB-IoT or congested networks.

# ── LTE ───────────────────────────────────────────────────────────────────────

config CONEXIO_CLOUD_MANAGE_LTE
	bool "SDK manages LTE connection"
	default y

config CONEXIO_CLOUD_LTE_TIMEOUT_SEC
	int "LTE registration timeout (seconds)"
	default 90
	range 30 300
	depends on CONEXIO_CLOUD_MANAGE_LTE

# ── MQTT ──────────────────────────────────────────────────────────────────────

config CONEXIO_CLOUD_MQTT_KEEPALIVE_SEC
	int "MQTT keepalive interval (seconds)"
	default 120
	range 30 600
	depends on CONEXIO_CLOUD_MQTT

# ── TLS tags (internal — change only on conflict) ─────────────────────────────

config CONEXIO_CLOUD_CA_TAG
	int "TLS CA certificate security tag"
	default 100

config CONEXIO_CLOUD_CERT_TAG
	int "TLS device certificate security tag"
	default 101
	depends on CONEXIO_CLOUD_MQTT

config CONEXIO_CLOUD_KEY_TAG
	int "TLS private key security tag"
	default 102
	depends on CONEXIO_CLOUD_MQTT

config CONEXIO_CLOUD_HTTP_CA_TAG
	int "TLS CA security tag (HTTP transport)"
	default 103
	depends on CONEXIO_CLOUD_HTTP

# ── Stack ─────────────────────────────────────────────────────────────────────

config CONEXIO_CLOUD_THREAD_STACK_SIZE
	int "SDK background thread stack size"
	default 4096
	range 2048 16384

endmenu # Connection

# ── FOTA — Firmware Over-the-Air updates ─────────────────────────────────────

menu "FOTA (Firmware Over-the-Air)"

config CONEXIO_CLOUD_FOTA
	bool "Enable FOTA (Firmware Over-the-Air) support"
	depends on CONEXIO_CLOUD_MQTT
	select FOTA_DOWNLOAD
	select FOTA_DOWNLOAD_PROGRESS_EVT
	select BOOTLOADER_MCUBOOT
	select IMG_MANAGER
	select DFU_TARGET
	select DFU_TARGET_MCUBOOT
	select DOWNLOADER
	select STREAM_FLASH
	help
	  Enables firmware updates via the Conexio Cloud Console.
	  When a firmware job is created, the SDK receives a FIRMWARE_UPDATE
	  command, downloads the binary from the pre-signed download URL, and
	  installs it via MCUboot on next reboot.
	  Requires a dual-bank MCUboot partition layout in the board DTS.
	  Include <fota.h> in your application for the event callback type.

config CONEXIO_CLOUD_FOTA_DOWNLOAD_TIMEOUT_SEC
	int "FOTA download timeout (seconds)"
	default 300
	range 60 600
	depends on CONEXIO_CLOUD_FOTA
	help
	  Maximum seconds to wait for a firmware binary to download before
	  aborting. Handled by CONFIG_FOTA_DOWNLOAD_TIMEOUT_MS in NCS v3.2.1.
	  This option is kept for documentation purposes but is no longer passed
	  to fota_download_start() (whose 5th argument is fragment_size, not timeout).
	  Configure the actual timeout via CONFIG_FOTA_DOWNLOAD_TIMEOUT_MS in prj.conf.
	  600s (10 min) is the maximum — beyond this a stuck download drains the
	  battery without benefit. Typical download time is under 2 minutes on NB-IoT.

endmenu # FOTA

# ── Offline buffer — flash-backed telemetry buffering ────────────────────────

menu "Offline Buffer"

config CONEXIO_CLOUD_OFFLINE_BUFFER
	bool "Enable offline telemetry buffer"
	select NVS
	select FLASH
	select FLASH_PAGE_LAYOUT
	select FLASH_MAP
	select MPU_ALLOW_FLASH_WRITE
	help
	  When the device loses cloud connectivity, telemetry payloads are stored
	  in internal flash using Zephyr NVS. On reconnection, buffered payloads
	  are replayed to the cloud in chronological order before resuming live
	  telemetry. Uses a ring buffer — oldest entries are dropped when full.
	  Include <offline_buffer.h> in your application.

config CONEXIO_CLOUD_OFFLINE_BUFFER_SIZE
	int "Maximum number of payloads to buffer"
	default 100
	range 10 500
	depends on CONEXIO_CLOUD_OFFLINE_BUFFER
	help
	  Each entry holds one complete telemetry JSON payload (up to 512 bytes).
	  100 entries at a 60s interval = ~100 minutes of offline coverage.

config CONEXIO_CLOUD_OFFLINE_REPLAY_BATCH
	int "Payloads to replay per reconnect session"
	default 10
	range 1 50
	depends on CONEXIO_CLOUD_OFFLINE_BUFFER
	help
	  How many buffered payloads to send after each reconnect before
	  switching back to live telemetry. Prevents replay storms.

config CONEXIO_CLOUD_OFFLINE_BUFFER_FULL_CB
	bool "Enable buffer-full notification callback"
	default n
	depends on CONEXIO_CLOUD_OFFLINE_BUFFER
	help
	  When enabled, the SDK calls a user-registered callback whenever the
	  offline buffer is full and an oldest entry is being dropped.
	  Useful for status LEDs, logging, or stopping data collection when
	  storage is exhausted.
	  Register with: conexio_cloud_register_offline_buffer_full_cb(cb).

endmenu # Offline Buffer

# ── Power manager — LTE PSM / eDRX ───────────────────────────────────────────

menu "Power Management (PSM / eDRX)"

config CONEXIO_CLOUD_PSM
	bool "Enable LTE Power Saving Mode (PSM) support"
	select LTE_LC_PSM_MODULE
	select LTE_LC_EDRX_MODULE
	select LTE_LC_MODEM_SLEEP_MODULE
	help
	  Negotiates PSM or eDRX with the LTE network to minimise current draw
	  between telemetry transmissions. Typical improvement: 5–20x battery
	  life versus always-on connected mode.
	  PSM current: ~2–3 µA sleep vs ~6–10 mA idle connected.
	  Include <power_mgr.h> in your application.

config CONEXIO_CLOUD_PSM_TAU_SEC
	int "PSM Tracking Area Update timer (seconds)"
	default 3600
	range 60 604800
	depends on CONEXIO_CLOUD_PSM
	help
	  How often the modem sends a keepalive (T3412 timer) to the network.
	  Set to at least 2× your telemetry interval to avoid extra radio wakeups.
	  Maximum matches INTERVAL_SEC ceiling (7 days) for ultra-low-power deployments.

config CONEXIO_CLOUD_PSM_ACTIVE_TIME_SEC
	int "PSM active window (seconds)"
	default 10
	range 2 300
	depends on CONEXIO_CLOUD_PSM
	help
	  How long the modem stays awake after waking (T3324 timer).
	  Must be long enough for LTE re-registration + full MQTT publish cycle.
	  10–30 seconds is sufficient for most networks; increase to 120–300s
	  on congested or slow-to-register NB-IoT deployments.

config CONEXIO_CLOUD_EDRX
	bool "Enable eDRX instead of PSM"
	default n
	depends on CONEXIO_CLOUD_PSM
	help
	  Use extended Discontinuous Reception (eDRX) instead of PSM.
	  eDRX provides faster command reception latency at the cost of higher
	  idle current. Do not enable both PSM and eDRX simultaneously.

endmenu # Power Management

# ── Retry / watchdog — exponential backoff + hardware watchdog ───────────────

menu "Retry and Watchdog"

config CONEXIO_CLOUD_RETRY
	bool "Enable exponential backoff retry and hardware watchdog"
	select WATCHDOG
	help
	  Manages cloud reconnection attempts with jittered exponential backoff
	  to avoid reconnect storms after network outages. Also arms the hardware
	  watchdog so the device automatically reboots if the main loop stalls
	  (catches modem hangs, deadlocks, and infinite retry loops).
	  Include <retry.h> in your application.

config CONEXIO_CLOUD_RETRY_BASE_SEC
	int "Base retry interval (seconds)"
	default 5
	range 1 60
	depends on CONEXIO_CLOUD_RETRY
	help
	  Initial wait before the first reconnection attempt.
	  Doubles on each failure: 5s → 10s → 20s → 40s → ... → max.

config CONEXIO_CLOUD_RETRY_MAX_SEC
	int "Maximum retry interval (seconds)"
	default 300
	range 30 86400
	depends on CONEXIO_CLOUD_RETRY
	help
	  Retry interval cap. Default 300s (5 minutes) is suitable for most
	  deployments. Increase for remote sensors where you want the device
	  to keep retrying slowly for extended periods before rebooting.

config CONEXIO_CLOUD_RETRY_MAX_ATTEMPTS
	int "Maximum consecutive failures before reboot"
	default 10
	range 3 50
	depends on CONEXIO_CLOUD_RETRY
	help
	  Reboot after this many consecutive connection failures.
	  Catches unrecoverable modem states that only a full power cycle fixes.

config CONEXIO_CLOUD_WATCHDOG_TIMEOUT_SEC
	int "Hardware watchdog timeout (seconds)"
	default 600
	range 60 86400
	depends on CONEXIO_CLOUD_RETRY
	help
	  The hardware watchdog fires and reboots the device if retry_kick_watchdog()
	  has not been called within this window. Call it from your main loop.
	  Must be greater than RETRY_MAX_SEC × RETRY_MAX_ATTEMPTS to avoid
	  a spurious reboot during a normal backoff sequence.

endmenu # Retry and Watchdog

# ── Cellular Location (AWS Location Service) ─────────────────────────────────

menu "Cellular Location"

config CELL_LOCATION
	bool "Enable cellular location via AT%NCELLMEAS"
	depends on CONEXIO_CLOUD
	select LTE_LC_NEIGHBOR_CELL_MEAS_MODULE
	select CJSON_LIB
	help
	  Enables neighbor cell measurement using the AT%NCELLMEAS command.
	  Serving cell + up to 17 neighbor cells are serialized as telemetry
	  metrics (_loc_mcc, _loc_mnc, _loc_cell_id, _loc_tac, _loc_earfcn,
	  _loc_rsrp, _loc_timing_adv, _loc_neighbors) and queued for the next
	  regular telemetry publish.
	  The cloud Lambda resolves the cell data to coordinates using HERE /
	  Combain or another positioning API and stores the result in AWS
	  Location Tracker.
	  No positioning solver runs on the device — firmware stays thin and
	  solver-agnostic.

config CELL_LOCATION_INTERVAL_SEC
	int "Cell location measurement interval (seconds)"
	default 28800
	range 60 604800
	depends on CELL_LOCATION
	help
	  How often to trigger an AT%NCELLMEAS measurement, in seconds.
	  This is independent from the telemetry publish interval so you can
	  publish telemetry frequently while solving location only a few times
	  per day — keeping HERE / AWS Location API costs minimal.

	  Recommended values:
	    28800  (8 hours)  — 3 fixes/day; typical production field tracking
	    14400  (4 hours)  — 6 fixes/day; moderate tracking
	    3600   (1 hour)   — 24 fixes/day; high-frequency tracking
	    60     (1 min)    — development / pipeline testing only

	  Cost guide (HERE Base Plan, 3 fixes/device/day):
	    10 devices  →   ~900 requests/month  — within free tier
	    100 devices →  ~9,000 requests/month — ~$9/month
	    1,000 devices → ~90,000 requests/month — negotiate volume agreement

	  The measurement takes 1–5 seconds and keeps the radio active, so
	  avoid calling it more than needed on battery-powered devices.

config CELL_LOCATION_PUBLISH_ON_FIX
	bool "Publish telemetry immediately after a location fix"
	default y
	depends on CELL_LOCATION
	help
	  When enabled (default), the SDK triggers an immediate telemetry
	  publish as soon as the AT%NCELLMEAS result is processed and the
	  _loc_* metrics are queued. This ensures the dashboard receives the
	  latest location data right away rather than waiting for the next
	  scheduled publish interval (which can be hours on low-power devices).

	  The publish is dispatched via a k_work item so it runs safely in the
	  system workqueue, not inside the LTE LC event handler callback.

	  Disable if you prefer location metrics to ride the next regular
	  telemetry publish (e.g. to batch location with other sensor data).

endmenu # Cellular Location

endif # CONEXIO_CLOUD
