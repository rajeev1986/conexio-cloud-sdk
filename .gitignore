# Build artifacts — generated by west build, never commit
build/
samples/*/build/

# Editor / IDE
.vscode/
.idea/
*.swp
*.swo

# macOS
.DS_Store

# Ingest key overlays — prj_ingest_key.conf and prj_ingest_key_dev.conf are
# committed as safe templates (no real keys). Per-developer copies with real
# keys must NOT be committed. Name your real-key file with a _local, personal,
# or similar suffix:
#   prj_ingest_key_local.conf
#   prj_ingest_key_rajeev.conf
*_ingest_key_local.conf
*_ingest_key_*.conf
# Allow the safe templates
!prj_ingest_key.conf
!prj_ingest_key_dev.conf
