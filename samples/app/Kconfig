mainmenu "Conexio Advanced Sample App"

# All production-grade feature configuration (PSM, FOTA, offline buffer,
# retry/watchdog) is defined in conexio-cloud-sdk/Kconfig under the
# CONFIG_CONEXIO_CLOUD_* namespace. Configure features via prj.conf.

config CONEXIO_SAMPLE_SIMULATED_SENSORS
	bool "Use simulated (random) sensor data"
	default y
	help
	  When enabled (default), temperature and humidity callbacks return
	  random values for demonstration purposes. A compiler warning is
	  emitted to prevent accidental production builds with fake data.

	  Set to n (CONFIG_CONEXIO_SAMPLE_SIMULATED_SENSORS=n in prj.conf)
	  and implement the real sensor reads in main.c before deploying
	  to production hardware.

source "Kconfig.zephyr"
